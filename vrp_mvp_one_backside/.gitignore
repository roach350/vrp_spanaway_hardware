# KiCad auto-generated / local — regenerated on open, or per-user state

# Auto-backups (zips) and local history snapshots
*-backups/
.history/
_autosave-*
*.kicad_pcb-bak
*.bak
*.kicad_sch-bak
# Per-user project local settings (UI state, window layout)
*.kicad_prl

# Rescue + symbol/footprint caches (regenerated by KiCad)
*-cache.lib
*-rescue.lib
*-rescue.dcm
fp-info-cache

# JLCPCB plugin — ignore the binary db and raw gerbers,
# but commit the fab deliverables: BOM/CPL CSVs + gerber zip.
jlcpcb/project.db
jlcpcb/gerber/
jlcpcb/production_files/*
!jlcpcb/production_files/*.csv
!jlcpcb/production_files/*.zip

# Legacy KiCad 5 files (superseded by .kicad_pro / .kicad_sch)
*.pro
*.sch

# Other KiCad stuff
*.lck


# OS cruft
.DS_Store
Thumbs.db


